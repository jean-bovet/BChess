    "Choose a folder outside BChess's own games: exporting there would list every game twice." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier en dehors des parties de BChess : l’exportation y ferait apparaître chaque partie en double."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Ordner ausserhalb der BChess-Partien: Beim Exportieren dorthin würde jede Partie doppelt aufgelistet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una cartella fuori dalle partite di BChess: esportando lì, ogni partita comparirebbe due volte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחרו תיקייה מחוץ למשחקים של BChess: ייצוא לשם יציג כל משחק פעמיים."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مجلدًا خارج ألعاب BChess نفسها: فالتصدير إليه سيعرض كل لعبة مرتين."
          }
        }
      }
    },
